      "type": "object",
      "required": [],
      "title": "Map Base Layers"
    },
    "Home Range Method": {
      "type": "object",
      "description": "Choose which home-range estimation method to compute for the map and table.",
      "ecoscope:task_group": true,
      "properties": {
        "home_range_args": {
          "additionalProperties": false,
          "properties": {
            "args": {
              "anyOf": [
                {
                  "$ref": "#/$defs/McpMethodArgs"
                },
                {
                  "$ref": "#/$defs/EtdMethodArgs"
                },
                {
                  "$ref": "#/$defs/BbmmMethodArgs"
                }
              ],
              "default": {
                "mcp_opacity": 0.7,
                "mcp_crs": "ESRI:102022",
                "mcp_percentiles": [
                  "50",
                  "60",
                  "70",
                  "80",
                  "90",
                  "95",
                  "99.999"
                ]
              },
              "title": "Method"
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        },
        "home_range_rings_correction": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Fix Overlapping Percentile Transparency",
              "type": "boolean",
              "description": "Home-range percentile polygons are cumulative and nested (the 90% area fully contains the 50% area, and so on), so when rendered with transparency, the overlapping regions stack and look more opaque than areas covered by only one percentile band. This is most noticeable at low opacity. Enabling this converts the nested polygons into non-overlapping rings first, so opacity renders uniformly across the map.",
              "default": false,
              "ecoscope:advanced": true
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "home_range_legend_title": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Legend Title",
          "type": "string",
          "description": "The title shown above the percentile color legend on the map.",
          "default": "Home Range %",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Legend Title"
    },
    "persist_etd_pct_grouped": {
      "additionalProperties": false,
      "properties": {
        "filetypes": {
          "default": [
            "csv"
          ],
          "items": {
            "enum": [
              "csv",
              "parquet"
            ],
            "type": "string"
          },
          "title": "Filetypes",
          "type": "array",
          "description": "The output format",
          "uniqueItems": true,
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Export Percentiles",
      "description": "File formats to export the home range percentile-area data in."
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "BoundingBox": {
      "properties": {
        "min_y": {
          "default": -90.0,
          "ecoscope:advanced": true,
          "title": "Min Latitude",
          "type": "number"
        },
        "max_y": {
          "default": 90.0,
          "ecoscope:advanced": true,
          "title": "Max Latitude",
          "type": "number"
        },
        "min_x": {
          "default": -180.0,
          "ecoscope:advanced": true,
          "title": "Min Longitude",
          "type": "number"
        },
        "max_x": {
          "default": 180.0,
          "ecoscope:advanced": true,
          "title": "Max Longitude",
          "type": "number"
        }
      },
      "title": "BoundingBox",
      "type": "object"
    },
    "Coordinate": {
      "properties": {
        "y": {
          "description": "Example -0.15293",
          "title": "Latitude",
          "type": "number"
        },
        "x": {
          "description": "Example 37.30906",
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "y",
        "x"
      ],
      "title": "Coordinate",
      "type": "object"
    },
    "TrajectorySegmentFilter": {
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "ecoscope:advanced": true,
          "minimum": 0.001,
          "title": "Minimum Segment Length (Meters)",
          "type": "number"
        },
        "max_length_meters": {
          "default": 100000,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Length (Meters)",
          "type": "number"
        },
        "min_time_secs": {
          "default": 1,
          "ecoscope:advanced": true,
          "minimum": 1,
          "title": "Minimum Segment Duration (Seconds)",
          "type": "number"
        },
        "max_time_secs": {
          "default": 172800,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 1,
          "title": "Maximum Segment Duration (Seconds)",
          "type": "number"
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Minimum Segment Speed (Kilometers per Hour)",
          "type": "number"
        },
        "max_speed_kmhr": {
          "default": 500,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Speed (Kilometers per Hour)",
          "type": "number"
        }
      },
      "title": "TrajectorySegmentFilter",
      "type": "object"
    },
    "SpatialGrouper": {
      "properties": {
        "spatial_index_name": {
          "title": "Spatial Regions",
          "type": "string"
        }
      },
      "required": [
        "spatial_index_name"
      ],
      "title": "Spatial",
      "type": "object"
    },
    "TemporalGrouper": {
      "properties": {
        "temporal_index": {
          "oneOf": [
            {
              "const": "%Y",
              "title": "Year (example: 2024)"
            },
            {
              "const": "%B",
              "title": "Month (example: September)"
            },
            {
              "const": "%Y-%m",
              "title": "Year and Month (example: 2023-01)"
            },
            {
              "const": "%j",
              "title": "Day of the year as a number (example: 365)"
            },
            {
              "const": "%d",
              "title": "Day of the month as a number (example: 31)"
            },
            {
              "const": "%A",
              "title": "Day of the week (example: Sunday)"
            },
            {
              "const": "%H",
              "title": "Hour (24-hour clock) as number (example: 22)"
            },
            {
              "const": "%Y-%m-%d",
              "title": "Date (example: 2025-01-31)"
            }
          ],
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "temporal_index"
      ],
      "title": "Time",
      "type": "object"
    },
    "ValueGrouper": {
      "properties": {
        "index_name": {
          "title": "Category",
          "type": "string",
          "oneOf": [
            {
              "const": "subject_name",
              "title": "Subject Name"
            },
            {
              "const": "subject_subtype",
              "title": "Subject Subtype"
            },
            {
              "const": "subject_sex",
              "title": "Subject Sex"
            }
          ]
        }
      },
      "required": [
        "index_name"
      ],
      "title": "Category",
      "type": "object"
    },
    "AutoScaleGridCellSize": {
      "properties": {
        "auto_scale_or_custom": {
          "const": "Auto-scale",
          "default": "Auto-scale",
          "ecoscope:advanced": true,
          "enum": [
            "Auto-scale"
          ],
          "title": "Grid Cell Size",
          "type": "string"
        }
      },
      "title": "Auto-scale",
      "type": "object"
    },
    "BbmmMethodArgs": {
      "properties": {
        "bbmm_opacity": {
          "default": 1,
          "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
          "ecoscope:advanced": true,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Layer Opacity",
          "type": "number"
        },
        "bbmm_crs": {
          "default": "EPSG:3857",
          "description": "The coordinate reference system in which to perform the calculation, must be a valid CRS authority code, for example ESRI:53042",
          "ecoscope:advanced": true,
          "title": "Coordinate Reference System",
          "type": "string"
        },
        "location_error": {
          "default": 20.0,
          "description": "Typical GPS collar accuracy - the standard deviation of a single fix's positional error.",
          "ecoscope:advanced": true,
          "title": "GPS Location Error (meters)",
          "type": "number"
        },
        "time_step_seconds": {
          "default": 60.0,
          "description": "How finely each movement segment is broken into steps when computing the density surface - smaller values are more precise but slower to compute.",
          "ecoscope:advanced": true,
          "title": "Bridge Integration Time Step (seconds)",
          "type": "number"
        },
        "bbmm_expansion_factor": {
          "default": 1.3,
          "description": "Pads the calculation grid beyond the trajectory's own bounding box, so the density surface has room to taper off naturally instead of being cut off at the edge.",
          "ecoscope:advanced": true,
          "title": "Shape Buffer Expansion Factor",
          "type": "number"
        },
        "max_data_gap_seconds": {
          "default": 14400.0,
          "description": "Fixes separated by a gap this long or longer are excluded rather than modeled as one highly uncertain bridge - a long gap usually reflects a data outage (e.g. a collar dropout), not real movement uncertainty.",
          "ecoscope:advanced": true,
          "title": "Maximum Data Gap (seconds)",
          "type": "number"
        },
        "bbmm_percentiles": {
          "default": [
            "50",
            "60",
            "70",
            "80",
            "90",
            "95",
            "99.999"
          ],
          "ecoscope:advanced": true,
          "items": {
            "enum": [
              "50",
              "60",
              "70",
              "80",
              "90",
              "95",
              "99",
              "99.999",
              "100"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Percentile Levels",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "location_error"
      ],
      "title": "Brownian Bridge Movement Model (BBMM)",
      "type": "object"
    },
    "CustomGridCellSize": {
      "properties": {
        "auto_scale_or_custom": {
          "const": "Customize",
          "default": "Customize",
          "ecoscope:advanced": true,
          "enum": [
            "Customize"
          ],
          "title": "Grid Cell Size",
          "type": "string"
        },
        "grid_cell_size": {
          "default": 5000,
          "description": "Define the resolution of the raster grid (in the unit of measurement defined by the coordinate reference system set below). A smaller grid cell size provides more detail, while a larger size generalizes the data.",
          "exclusiveMaximum": 10000,
          "exclusiveMinimum": 0,
          "gt": 0,
          "lt": 10000,
          "title": "Custom Grid Cell Size",
          "type": "number"
        }
      },
      "title": "Customize",
      "type": "object"
    },
    "EtdMethodArgs": {
      "description": "Field names are prefixed (etd_opacity, not opacity) so that NO property name is\nshared with McpMethodArgs/BbmmMethodArgs - required because RJSF's own anyOf-branch-\nmatching (getMatchingOption, in @rjsf/utils) deletes each schema's `required` array\nbefore checking it, falling back to \"does the data have at least one of this\noption's own property names\" - so shared field names across variants make multiple\noptions match simultaneously regardless of what's required. max_speed_factor is\nstill made genuinely required (no real pydantic default, only a schema-level one\nvia json_schema_extra) as the backend/pydantic-side disambiguation signal (e.g. for\na CLI/param.yaml submission with no home_range_args override at all). The working\nprecedent this pattern is borrowed from - ecoscope_workflows_ext_custom's\nFeatureSetQuery | FeatureTypeQuery | FeatureIdQuery (_spatial_features.py) - avoids\ncross-variant ambiguity the same way: every variant's own field names are entirely\nunique across all three.",
      "properties": {
        "etd_opacity": {
          "default": 1,
          "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
          "ecoscope:advanced": true,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Layer Opacity",
          "type": "number"
        },
        "auto_scale_or_custom_cell_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoScaleGridCellSize"
            },
            {
              "$ref": "#/$defs/CustomGridCellSize"
            }
          ],
          "default": {
            "auto_scale_or_custom": "Auto-scale"
          },
          "ecoscope:advanced": true,
          "title": "Grid Cell Size"
        },
        "etd_crs": {
          "default": "EPSG:3857",
          "description": "The coordinate reference system in which to perform the calculation, must be a valid CRS authority code, for example ESRI:53042",
          "ecoscope:advanced": true,
          "title": "Coordinate Reference System",
          "type": "string"
        },
        "max_speed_factor": {
          "default": 1.05,
          "description": "Caps the subject's assumed top speed as a multiple of the fastest speed actually observed in the data - higher values allow more distant possible locations between consecutive fixes.",
          "ecoscope:advanced": true,
          "title": "Max Speed Factor (Kilometers per Hour)",
          "type": "number"
        },
        "etd_expansion_factor": {
          "default": 1.3,
          "description": "Pads the calculation grid beyond the trajectory's own bounding box, so the density surface has room to taper off naturally instead of being cut off at the edge.",
          "ecoscope:advanced": true,
          "title": "Shape Buffer Expansion Factor",
          "type": "number"
        },
        "etd_percentiles": {
          "default": [
            "50",
            "60",
            "70",
            "80",
            "90",
            "99.999"
          ],
          "ecoscope:advanced": true,
          "items": {
            "enum": [
              "50",
              "60",
              "70",
              "80",
              "90",
              "95",
              "99",
              "99.999",
              "100"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Percentile Levels",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "max_speed_factor"
      ],
      "title": "Elliptical Time-Density (ETD)",
      "type": "object"
    },
    "McpMethodArgs": {
      "description": "See EtdMethodArgs' own docstring - fields are prefixed to keep every property\nname unique across all three Method variants, which is what RJSF's own anyOf-\nmatching heuristic actually needs (not just a genuinely-required field).",
      "properties": {
        "mcp_opacity": {
          "default": 1,
          "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
          "ecoscope:advanced": true,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Layer Opacity",
          "type": "number"
        },
        "mcp_crs": {
          "default": "ESRI:102022",
          "description": "The projected coordinate reference system used to rank fixes by distance from the centroid and compute hull areas - must be a valid CRS code, e.g. ESRI:102022.",
          "ecoscope:advanced": true,
          "title": "Coordinate Reference System",
          "type": "string"
        },
        "mcp_percentiles": {
          "default": [
            "50",
            "60",
            "70",
            "80",
            "90",
            "95",
            "99.999"
          ],
          "ecoscope:advanced": true,
          "items": {
            "enum": [
              "50",
              "60",
              "70",
              "80",
              "90",
              "95",
              "99",
              "99.999",
              "100"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Percentile Levels",
          "type": "array",
          "uniqueItems": true
        }
      },
      "title": "MCP (Minimum Convex Polygon)",
      "type": "object"
    }
